[run]
# Without this, coverage reports only the files something imported -- and
# register_user.py and attendance.py are never imported by a test, so 99
# statements of shipped code were missing from the report entirely rather
# than showing as uncovered. The percentage was measured over a subset and
# read 61.5% where the honest figure is 58.4%. A coverage report that
# silently excludes untested modules flatters exactly the code that needs
# the most attention.
# The code folders have no __init__.py (namespace packages), and `source = .` only reports a never-imported
# file when its folder is a regular package. So a module no test imports -- cli/face_attendance.py,
# analysis/fairness_benchmark.py -- dropped out of the report entirely instead of showing at 0%.
# source_dirs (coverage 7.10+) walks the folders themselves, so every shipped file is counted.
source_dirs =
    .
    cli
    analysis
    core
    pipeline
    tools

# Branches as well as lines: a line-only figure counts an `if` whose else-path never ran as fully covered.
branch = True

# Only what is not shipped code: the tests, a virtualenv, the published page.
# tools/ used to be here as a folder -- the corpus scripts, the demo build and
# the figure refresher, 1,300 statements in all -- and is not any more: each
# is tested against a corpus or a browser stand-in built at test time, so the
# 100% below is over every .py file in the repository outside tests/.
#
# A stale name here does not fail: `omit` that matches nothing is silently
# ignored, the module rejoins the report, and the published coverage
# percentage moves for reasons that have nothing to do with the tests. Do not
# add to this list to make a number go up.
omit =
    tests/*
    .venv/*
    docs/*

[report]
# The CI figure (no weights, no dataset/, no sample face: exactly what the push
# job has, but with pyarrow and Pillow installed from requirements-test.txt) is
# 100%: every statement and every branch of every module, tools/ included,
# lines and branches combined since branch = True. That was 96% (109 lines
# missed) on 2026-10-11 before the sixth pass in notes/CODE_AUDIT.md closed the
# gap; 96.5% on 2026-10-10 before that.
# Rounded down, so a run that loses ground fails `coverage report` instead of
# passing quietly. Lower it only with a reason in notes/CODE_AUDIT.md.
fail_under = 100

# The one exclusion: the `if __name__ == "__main__":` guard, whose body only
# calls the module's entry point -- main(), cli() or train() -- which the
# tests call directly. A guard that did more (app.py, core/db.py) had its body
# moved into a tested main() instead. coverage's default `pragma: no cover`
# marker still works under exclude_also, so tests/test_published_figures.py
# fails if any module carries one.
exclude_also =
    if __name__ == .__main__.:
